# Copy to .env. All settings are optional; defaults shown.
OS_OLLAMA_URL=http://127.0.0.1:11434
OS_OLLAMA_MODEL=qwen2.5:3b
OS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# After running scripts/download_models.py, set to 1 to forbid any network use:
OS_OFFLINE=0
OS_MIN_SCORE=0.25
# Answers whose words are mostly not in the cited passages are treated as not found:
OS_MIN_ANSWER_SUPPORT=0.55
# Maximum answer length in tokens (about 15 tokens/s on a laptop CPU):
OS_LLM_MAX_TOKENS=400
OS_OCR_ENABLED=1
# Only needed if tesseract is neither on PATH nor in C:\Program Files\Tesseract-OCR:
# OS_TESSERACT_CMD=D:\Tools\Tesseract-OCR\tesseract.exe
